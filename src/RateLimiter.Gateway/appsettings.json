{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RateLimit": {
    "FailurePolicy": "FailClose",
    "TimeoutMs": 50,
    "HealthCheckIntervalSeconds": 5,
    "Redis": {
      "ConnectionString": "localhost:6379"
    },
    "Middleware": {
      "IdentificationPriority": ["ApiKey", "UserId", "IpAddress"]
    },
    "ConfigPoller": {
      "PollInterval": "00:00:30"
    },
    "ConfigStore": {
      "FilePath": "ratelimit-rules.json"
    }
  }
}
